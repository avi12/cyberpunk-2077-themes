{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/oxlint-config-avi12/wxt.json", "./node_modules/oxlint-plugin-naming/preset.json"],
  "rules": {
    "naming/convention": [
      "error",
      {
        "presets": ["webextension-manifest"],
        "allowedNames": [{ "reason": "WXT names its build hook with a colon", "names": ["build:done"] }]
      }
    ]
  },
  "ignorePatterns": ["**/dist/**", "**/.output/**", "**/.wxt/**", "**/node_modules/**"]
}
